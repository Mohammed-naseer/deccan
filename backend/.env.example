# Deccan Space Works — Production Environment Configuration
# Copy this file to .env and fill in your actual production credentials

# Environment Mode
ENVIRONMENT=development
PORT=8000

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=deccan_space_works

# Security & JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary Media Storage (Images & Videos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
OWNER_EMAIL=Deccanspaceworks@gmail.com
SENDER_EMAIL=notifications@deccanspaceworks.com

# Official WhatsApp Cloud / Business API (Optional)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_RECIPIENT_NUMBER=919100720137

# Frontend URL for CORS
FRONTEND_URL=https://deccan-five.vercel.app,http://localhost:3000,http://127.0.0.1:3000
